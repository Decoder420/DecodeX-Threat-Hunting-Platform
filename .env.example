# ==============================================================================
# DecodeX Threat Hunting & Web Security Platform — Environment Configuration
# ==============================================================================
# Copy this template to .env before starting the platform:
#   cp .env.example .env
#
# NOTE FOR EVALUATION / LOCAL TESTING:
# You can run ./scripts/first-run.sh to automatically populate this file with
# freshly generated cryptographic keys and start the containers.
#
# NOTE FOR PRODUCTION DEPLOYMENTS:
# Never commit real .env files to version control. Set dedicated, high-entropy
# secrets and review all network exposure settings.
# ==============================================================================

# --- Access Control & Administrative Passwords ---
TH_ADMIN_USERNAME=admin
TH_ADMIN_PASSWORD=ChangeMe_Admin_Password123!

TH_ANALYST_USERNAME=analyst
TH_ANALYST_PASSWORD=ChangeMe_Analyst_Password123!

TH_VIEWER_USERNAME=viewer
TH_VIEWER_PASSWORD=ChangeMe_Viewer_Password123!

# --- Cryptographic Keys & Vault (CRITICAL) ---
# ENCRYPTION_KEY: Dedicated 32-byte Fernet key for encrypting scan credentials at rest.
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# SECRET_KEY: Application session signing key.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Service Host & Networking ---
HOST=0.0.0.0
PORT=5000
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
TH_FLASK_DEBUG=false
TH_ENABLE_DEBUG_ROUTES=false

# --- Web Scanner Safety & Resource Caps ---
WEBSCAN_ENABLED=true
WEBSCAN_MAX_CONCURRENT=2
WEBSCAN_TIMEOUT=300
WEBSCAN_REQUEST_TIMEOUT=10
WEBSCAN_MAX_URLS=100
WEBSCAN_MAX_CRAWL_DEPTH=2
WEBSCAN_MAX_RESPONSE_BYTES=512000

# SECURITY GUARDRAIL: Keep false to prevent scanning RFC-1918 / localhost ranges (SSRF).
# Only set to true in dedicated, air-gapped lab testing environments.
WEBSCAN_ALLOW_PRIVATE_TARGETS=false

# Default request budget per scan to prevent unbounded crawl loops on slow targets
WEBSCAN_REQUEST_BUDGET=1000
WEBSCAN_PRODUCTION_SAFETY_MODE=true
WEBSCAN_LAB_MODE=false
WEBSCAN_DEMO_MODE=false

# --- Scanner Engines ---
NUCLEI_ENABLED=true
NUCLEI_PATH=nuclei

NMAP_ENABLED=true
NMAP_PATH=nmap

# OWASP ZAP Daemon Integration
ZAP_ENABLED=true
ZAP_URL=http://zap:8080
# ZAP_API_KEY: Authenticates communications between backend and ZAP daemon.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(16))"
ZAP_API_KEY=

# --- Database Storage ---
# Use DELETE on macOS / Docker Desktop (VirtioFS mounts) to prevent file locking corruption.
# Use WAL on native Linux production servers.
SQLITE_JOURNAL_MODE=DELETE
