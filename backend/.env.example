# Copy to backend/.env and set real passwords (never commit .env).
# On backend startup these credentials create/sync the three role accounts.
# Passwords must be 8+ characters. Restart the server after editing.
#
# Auth uses hashed passwords + revocable DB session tokens (see /api/auth/*).
# Permissions are derived from role (admin / analyst / viewer) — see ROLE_PERMISSIONS in src/th/db.py.

# --- admin (full access) ---
TH_ADMIN_USERNAME=admin
TH_ADMIN_PASSWORD=Manan@123

# --- analyst (hunt / case / feeds) ---
TH_ANALYST_USERNAME=analyst
TH_ANALYST_PASSWORD=ChangeMe_Analyst_Password123!

# --- viewer (read-only) ---
TH_VIEWER_USERNAME=viewer
TH_VIEWER_PASSWORD=ChangeMe_Viewer_Password123!

# --- server ---
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
TH_FLASK_DEBUG=false
TH_ENABLE_DEBUG_ROUTES=false
