# Copy to backend/.env and configure your local environment credentials.
# Never commit real .env files to version control.

# --- Core User Roles & Credentials ---
TH_ADMIN_USERNAME=admin
# Administrator password: must be non-empty. Auto-generated on first run by scripts/first-run.sh
TH_ADMIN_PASSWORD=

TH_ANALYST_USERNAME=analyst
# Security Analyst password: must be non-empty. Auto-generated on first run by scripts/first-run.sh
TH_ANALYST_PASSWORD=

TH_VIEWER_USERNAME=viewer
# Viewer password: must be non-empty. Auto-generated on first run by scripts/first-run.sh
TH_VIEWER_PASSWORD=

# --- Server Settings ---
HOST=127.0.0.1
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://localhost
TH_FLASK_DEBUG=false
TH_ENABLE_DEBUG_ROUTES=false

# --- Web Application Security Scanning Settings ---
WEBSCAN_ENABLED=true
WEBSCAN_MAX_CONCURRENT=2
WEBSCAN_TIMEOUT=300
WEBSCAN_REQUEST_TIMEOUT=10
WEBSCAN_MAX_URLS=50
WEBSCAN_MAX_CRAWL_DEPTH=2
WEBSCAN_MAX_RESPONSE_BYTES=512000
WEBSCAN_ALLOW_PRIVATE_TARGETS=false
WEBSCAN_REQUEST_BUDGET=10000
WEBSCAN_PRODUCTION_SAFETY_MODE=true
WEBSCAN_LAB_MODE=false
WEBSCAN_DEMO_MODE=false

# --- External Engines ---
NUCLEI_ENABLED=true
NUCLEI_PATH=nuclei

NMAP_ENABLED=true
NMAP_PATH=nmap

ZAP_ENABLED=true
ZAP_URL=http://127.0.0.1:8080
ZAP_API_KEY=your_zap_api_key_here
